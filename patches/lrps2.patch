diff --git a/sw2/sw2_posix.c b/sw2/sw2_posix.c
new file mode 100644
index 0000000..c967ff7
--- /dev/null
+++ b/sw2/sw2_posix.c
@@ -0,0 +1,53 @@
+/* SW2PS2: the few POSIX memory calls the core makes, for the Switch 2
+ * homebrew toolchain. Anonymous mappings are zeroed, page-aligned heap
+ * blocks; file-backed and fixed-address mappings are refused (callers have
+ * fallbacks); page protection does not exist (the core is built with
+ * SW2_NO_FAULTS and never relies on it). */
+#include <malloc.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <switch.h>
+
+#define SW2_MAX_MAPS 256
+static struct { void* p; size_t len; } sw2_maps[SW2_MAX_MAPS];
+static Mutex sw2_maps_lock;
+
+void* mmap(void* addr, size_t len, int prot, int flags, int fildes, size_t off)
+{
+   void* p;
+   int i;
+   (void)prot; (void)off;
+   if (fildes >= 0 || (flags & MAP_FIXED) || !len)
+      return MAP_FAILED;
+   (void)addr; /* a hint only: callers that need it compare the result */
+   len = (len + 0xfff) & ~(size_t)0xfff;
+   p = memalign(0x1000, len);
+   if (!p)
+      return MAP_FAILED;
+   memset(p, 0, len);
+   mutexLock(&sw2_maps_lock);
+   for (i = 0; i < SW2_MAX_MAPS; i++)
+      if (!sw2_maps[i].p) { sw2_maps[i].p = p; sw2_maps[i].len = len; break; }
+   mutexUnlock(&sw2_maps_lock);
+   if (i == SW2_MAX_MAPS) { free(p); return MAP_FAILED; }
+   return p;
+}
+
+int munmap(void* addr, size_t len)
+{
+   int i, found = 0;
+   (void)len;
+   mutexLock(&sw2_maps_lock);
+   for (i = 0; i < SW2_MAX_MAPS; i++)
+      if (sw2_maps[i].p == addr && addr) { sw2_maps[i].p = NULL; found = 1; break; }
+   mutexUnlock(&sw2_maps_lock);
+   if (found)
+      free(addr); /* a partial unmap of a block is ignored */
+   return 0;
+}
+
+int mprotect(void* addr, size_t len, int prot)
+{
+   (void)addr; (void)len; (void)prot;
+   return 0;
+}
