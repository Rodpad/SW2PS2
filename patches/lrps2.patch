+/* SW2PS2: how many JIT regions are live and their total size (leak check). */
+int memjit_live_regions(size_t *bytes)
+{
+   int i, n = 0; size_t b = 0;
+   for (i = 0; i < (int)(sizeof(memjit_regions) / sizeof(memjit_regions[0])); i++)
+      if (memjit_regions[i].rx) { n++; b += memjit_regions[i].len; }
+   if (bytes) *bytes = b;
+   return n;
