+      __atomic_fetch_add(&memjit_stat_bytes, n, __ATOMIC_RELAXED);
+      __atomic_fetch_add(&memjit_stat_ticks, armGetSystemTick() - t0, __ATOMIC_RELAXED);
+      return R_SUCCEEDED(rc) ? 0 : -1;
+   }
+#else
+   pthread_jit_write_protect_np(0);
