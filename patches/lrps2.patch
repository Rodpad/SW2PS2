+void memjit_get_stats(unsigned long long *n, unsigned long long *bytes, unsigned long long *ticks)
+{
+   *n = memjit_stat_n; *bytes = memjit_stat_bytes; *ticks = memjit_stat_ticks;
+}
+
+/* Publishes [start, end) of a JIT region: staging bytes become executable. */
+static int memjit_publish(memjit_region_t *r, unsigned char *start, unsigned char *end)
+{
+   size_t off = (size_t)(start - r->rx), n;
+   if (end > r->rx + r->len)
+      end = r->rx + r->len;
+   if (end <= start)
+      return 0;
+   n = (size_t)(end - start);
