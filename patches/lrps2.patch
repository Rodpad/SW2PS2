diff --git a/pcsx2/sw2_prof.h b/pcsx2/sw2_prof.h
new file mode 100644
index 0000000..b23497c
--- /dev/null
+++ b/pcsx2/sw2_prof.h
@@ -0,0 +1,31 @@
+/* SW2PS2: region tags for the front end's sampling profiler. The EE thread
+ * stores which subsystem it is in; a sampler thread on another core reads
+ * it. Only functions that run on the EE thread carry a tag. */
+#ifndef SW2_PROF_H
+#define SW2_PROF_H
+#ifdef __cplusplus
+extern "C" {
+#endif
+enum { SW2P_EE = 1, SW2P_IOP, SW2P_SPU2, SW2P_GIF, SW2P_EVENTS, SW2P_VIF, SW2P_VU0, SW2P_COUNTERS,
+       SW2P_EE_COMPILE, SW2P_EE_VALIDATE, SW2P_GATE_WAIT, SW2P_GS_WAIT, SW2P_VU1_WAIT, SW2P_IOP_COMPILE, SW2P_DISC, SW2P_DMA, SW2P_IOPEVENT, SW2P_COUNT };
+extern volatile unsigned sw2_prof_region;
+unsigned sw2_prof_pc(int iop);
+static inline void sw2_prof_restore(unsigned* p) { sw2_prof_region = *p; }
+extern unsigned long long sw2_gs_stats[16];
+static inline unsigned long long sw2_ticks(void)
+{
+#if defined(__aarch64__)
+	unsigned long long v;
+	__asm__ __volatile__("mrs %0, cntpct_el0" : "=r"(v));
+	return v;
+#else
+	return 0;
+#endif
+}
+#define SW2_TIME_BEGIN() const unsigned long long sw2_tb = sw2_ticks()
+#define SW2_TIME_END(i) (sw2_gs_stats[i] += sw2_ticks() - sw2_tb)
+#define SW2_PROF(r) unsigned sw2_prof_prev __attribute__((cleanup(sw2_prof_restore))) = sw2_prof_region; sw2_prof_region = (r)
+#ifdef __cplusplus
+}
+#endif
+#endif
