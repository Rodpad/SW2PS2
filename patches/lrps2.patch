+
+#define MEMJIT_MAX_REGIONS 32
+typedef struct
+{
+   unsigned char *rx, *rw;
+   size_t len;
+#if defined(__SWITCH__)
+   Jit jit;
+#endif
+} memjit_region_t;
+static memjit_region_t memjit_regions[MEMJIT_MAX_REGIONS];
+
+static memjit_region_t *memjit_find_rx(const void *p)
+{
+   int i;
+   for (i = 0; i < MEMJIT_MAX_REGIONS; i++)
+   {
+      memjit_region_t *r = &memjit_regions[i];
+      if (r->rx && (const unsigned char*)p >= r->rx && (const unsigned char*)p < r->rx + r->len)
+         return r;
+   }
+   return NULL;
+}
+
+void *memjit_rw(const void *addr)
+{
+   memjit_region_t *r = memjit_find_rx(addr);
+   return r ? (void*)(r->rw + ((const unsigned char*)addr - r->rx)) : (void*)addr;
+}
+
+void *memjit_rx(const void *addr)
+{
+   int i;
+   for (i = 0; i < MEMJIT_MAX_REGIONS; i++)
+   {
+      memjit_region_t *r = &memjit_regions[i];
+      if (r->rx && (const unsigned char*)addr >= r->rw && (const unsigned char*)addr < r->rw + r->len)
+         return r->rx + ((const unsigned char*)addr - r->rw);
+   }
+   return (void*)addr;
+}
+
+void memjit_write_begin(void) { }
+void memjit_write_end(void)   { }
+
+void *memjit_alloc(size_t len)
+{
+   int i;
+   memjit_region_t *r = NULL;
+   for (i = 0; i < MEMJIT_MAX_REGIONS; i++)
+      if (!memjit_regions[i].rx && !memjit_regions[i].len) { r = &memjit_regions[i]; break; }
+   if (!r)
+      return NULL;
+   r->len = len; /* claims the slot */
+#if !defined(__SWITCH__)
+   if (getenv("MEMJIT_LOG")) fprintf(stderr, "memjit_alloc %zu KB -> slot %d\n", len >> 10, (int)(r - memjit_regions));
+#endif
+#if defined(__SWITCH__)
+   if (R_FAILED(jitCreate(&r->jit, len)))
+   {
+      r->len = 0;
+      return NULL;
+   }
+   r->rw = (unsigned char*)jitGetRwAddr(&r->jit);
+   memset(r->rw, 0, len);
+   jitTransitionToWritable(&r->jit);
+   if (R_FAILED(jitTransitionToExecutable(&r->jit)))
+   {
+      jitClose(&r->jit);
+      r->len = 0;
+      return NULL;
+   }
+   r->rx = (unsigned char*)jitGetRxAddr(&r->jit);
+#else
+   {
+      void *rx = mmap(NULL, len, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS | MAP_JIT, -1, 0);
+      void *rw = mmap(NULL, len, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+      if (rx == MAP_FAILED || rw == MAP_FAILED)
+      {
+         r->len = 0;
+         return NULL;
+      }
+      r->rw = (unsigned char*)rw;
+      r->rx = (unsigned char*)rx;
+   }
+#endif
+   return r->rx;
+}
+
+void memjit_free(void *addr, size_t len)
+{
+   memjit_region_t *r = addr ? memjit_find_rx(addr) : NULL;
+   (void)len;
+#if !defined(__SWITCH__)
+   if (getenv("MEMJIT_LOG")) fprintf(stderr, "memjit_free %p -> %s\n", addr, r && r->rx == (unsigned char*)addr ? "freed" : "NOT A REGION BASE");
+#endif
+   if (!r || r->rx != (unsigned char*)addr)
+      return;
+#if defined(__SWITCH__)
+   jitClose(&r->jit);
+#else
+   munmap(r->rx, r->len);
+   munmap(r->rw, r->len);
+#endif
+   r->rx = NULL;
+   r->rw = NULL;
+   r->len = 0;
+}
