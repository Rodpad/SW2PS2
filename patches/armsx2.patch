+		if (f >= s_next)
+		{
+			const double secs = std::chrono::duration<double>(std::chrono::steady_clock::now() - s_t0).count();
+			std::fprintf(stdout, "[bench] frame %llu at %.2f s (%.1f fps average)\n", (unsigned long long)f, secs, f / secs);
+			std::fflush(stdout);
+			s_next += 600;
+		}
+	}
 
 	bool options_updated = false;
 	if (environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE_UPDATE, &options_updated) && options_updated)
