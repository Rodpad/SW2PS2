 #if defined(__linux__)
 	EnsureCPUInfoInitialized(); // callable before the VM exists: the settings defaults and migration ask it
 	return GetPerformanceCoresMask();
+#elif defined(__APPLE__)
+	// SW2PS2 evaluation: the Mac's performance cores (sysctl hw.perflevel0.physicalcpu), so the
+	// IOP thread can be measured here as on the Switch 2 (whose cores are all the same).
+	static const u64 mask = []() {
