+		/// itself), and whose "wait until empty" callers notify fully first (MTVU's WaitVU does).
+		void NotifyOfWorkNoFence()
+		{
+			const s32 cur = m_state.load(std::memory_order_relaxed);
+			if (cur > 0 && (cur & (STATE_FLAG_WAITING_EMPTY - 1)) != 0)
+				return;
+			NotifyOfWork();
+		}
