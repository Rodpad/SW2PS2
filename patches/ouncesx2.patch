+		/// orders the caller's queue publish before the state read; the worker must issue a matching
+		/// seq_cst fence after clearing RUNNING_N and before rereading its queue (MTVU does).
+		void NotifyOfWorkLight()
+		{
+			std::atomic_thread_fence(std::memory_order_seq_cst);
+			const s32 cur = m_state.load(std::memory_order_relaxed);
+			if (cur > 0 && (cur & (STATE_FLAG_WAITING_EMPTY - 1)) != 0)
